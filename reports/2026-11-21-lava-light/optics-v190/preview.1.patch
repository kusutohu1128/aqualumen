+    // cross sections of the pyramidal bundle bound every intersecting voxel.
+    ivec3 boxMin=ivec3(100),boxMax=ivec3(-100);int solidCount=0;
+    int lastY=int(floor(receiver.y-.0001));
+    for(int y=floorY+1;y<=lastY;++y) {
