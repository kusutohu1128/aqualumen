+    allowedMin=max(low,receiver.xz+(vec2(openMin)-receiver.xz)/tRim);
+    allowedMax=min(high,receiver.xz+(vec2(openMax+1)-receiver.xz)/tRim);
+    if(any(lessThanEqual(allowedMax,allowedMin))) { direct=0.;return true; }
