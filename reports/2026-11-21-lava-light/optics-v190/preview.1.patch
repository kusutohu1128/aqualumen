+        vec2 lo=min(mix(receiver.xz,allowedMin,tlo),mix(receiver.xz,allowedMin,thi));
+        vec2 hi=max(mix(receiver.xz,allowedMax,tlo),mix(receiver.xz,allowedMax,thi));
